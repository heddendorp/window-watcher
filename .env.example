# Optional. Defaults are Untergiesing-Harlaching.
LOCATION_LABEL=Untergiesing-Harlaching
LATITUDE=48.0956
LONGITUDE=11.5611

# TADO_HOME_ID is optional locally but required on Railway so production
# reconnects can prove they belong to this exact home. TADO_ZONE_ID remains
# optional when all rooms should be included.
# TADO_HOME_ID=
# TADO_ZONE_ID=

# How much cooler outside must be before opening windows is worth it.
COOLING_MARGIN_C=2
REQUEST_TIMEOUT_MS=5000
# Bright Sky weather calls are cached so dashboard/page refreshes do not hit
# provider rate limits. Defaults to 240000.
# WEATHER_CACHE_MS=240000
# After a Bright Sky 429, pause new Bright Sky calls for this long and try the
# direct DWD observation fallback. Defaults to 600000.
# WEATHER_RATE_LIMIT_BACKOFF_MS=600000
# The direct DWD fallback only reports a value when enough fresh nearby station
# observations agree. Safe defaults are 90 minutes, 2 stations, and 3 deg C.
# DWD_OBSERVATION_MAX_AGE_MS=5400000
# DWD_MINIMUM_STATIONS=2
# DWD_MAXIMUM_SPREAD_C=3
# After a tado 429, pause fresh tado requests for this long and show last saved
# readings. Defaults to 600000.
# TADO_RATE_LIMIT_BACKOFF_MS=600000
# Optional. Defaults to 60000 locally and 600000 on Railway.
# SAMPLE_INTERVAL_MS=60000
# Set to false when sampling is handled by Railway cron through POST /api/sample.
# Keep the Railway web service itself always on.
# BACKGROUND_SAMPLER=false
# Secret bearer token for POST /api/sample.
# SAMPLE_TRIGGER_TOKEN=
OUTDOOR_TREND_HOURS=3
OUTDOOR_TREND_DELTA_C=0.3
# Rebound-aware room model. These defaults estimate stored heat and compare
# open-window and closed-window temperatures over the prediction horizon.
# THERMAL_MASS_TAU_HOURS=8
# REBOUND_FACTOR=0.7
# PREDICTION_HORIZON_MINUTES=90
# MIN_PREDICTED_OPEN_BENEFIT_C=0.3
# Forecast cooling must remain useful for this long before the app recommends
# opening later. This avoids recommendations based on one boundary datapoint.
# MIN_FORECAST_COOLING_WINDOW_MINUTES=30
# TARGET_MAX_C=22.5

# Authentication. Auth is off by default. Set both auth flags only after Clerk
# keys are configured and the Railway/browser sign-in UI should be active.
VITE_WINDOW_WATCHER_AUTH=false
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTHORIZED_EMAIL=you@example.com
# WINDOW_WATCHER_AUTH=true

# Persistence. On Railway, attach a volume and set RAILWAY_VOLUME_MOUNT_PATH,
# or explicitly set DATA_DIR. The tado token is stored in this directory.
# DATA_DIR=
# TADO_TOKEN_FILE=
# TADO_TOKEN_JSON= # one-time empty-volume bootstrap; remove after persistence is proven

# Local server port.
PORT=3000
